# ClinicaOS — variáveis de ambiente
# Copie este arquivo para `.env` e preencha com os valores do seu projeto Supabase.
# NÃO versione o `.env` real.

# --- Cliente (navegador) ---
# Usado pelo cliente Supabase no navegador (import.meta.env).
VITE_SUPABASE_URL=<sua_url_do_projeto>
VITE_SUPABASE_PUBLISHABLE_KEY=<sua_chave_publica>

# Origem permitida para redirecionamentos de convite (B6).
# Ex: https://patronus-flow.lovable.app
VITE_APP_ORIGIN=<sua_origem_do_app>

# (Opcional) E-mail exibido nos botoes de contato/ativacao.
# Sem valor, os botoes de contato ficam ocultos.
VITE_SUPPORT_EMAIL=<seu_email_de_suporte>

# --- Servidor (SSR e server functions) ---
# Usado nos módulos server-only e na validação de sessão.
SUPABASE_URL=<sua_url_do_projeto>
SUPABASE_PUBLISHABLE_KEY=<sua_chave_publica>

# Origem permitida para redirecionamentos de convite (B6) - lado servidor.
APP_ORIGIN=https://patronus-flow.lovable.app
# Usado nos módulos server-only e na validação de sessão.
SUPABASE_URL=<sua_url_do_projeto>
SUPABASE_PUBLISHABLE_KEY=<sua_chave_publica>

# Service role key: somente no servidor, contorna o RLS. NUNCA use em URLs, webhooks ou frontend.
SUPABASE_SERVICE_ROLE_KEY=<sua_service_role_key>

# Segredo do webhook de backups agendados (header Authorization: Bearer <segredo>).
# Gere com: openssl rand -base64 32
# NÃO é a service_role key — é um segredo dedicado para o agendador externo.
BACKUP_HOOK_SECRET=

# Chave de 32 bytes (hex de 64 chars) para criptografar os backups em AES-256-GCM.
# Gere com: openssl rand -hex 32
# Formatos aceitos: hex (64 chars), base64 (>=44 chars), ou passphrase (utf8, <32 -> SHA-256).
# NÃO use a service_role key aqui.
BACKUP_ENCRYPTION_KEY=
