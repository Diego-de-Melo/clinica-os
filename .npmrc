# npm config
# minimum-release-age=1440  # Requer npm >= 11.17 com suporte experimental; descomente quando disponível
# Compensação: npm audit obrigatório no CI (ver .github/workflows/ci.yml)

# Previne publicação acidental de pacotes privados
access = restricted

# Log level
loglevel = warn

# Engine strict
engine-strict = true